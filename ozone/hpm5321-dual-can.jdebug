/*********************************************************************
* Ozone project: hpm5321_dual_can BOOTLOADER -- JTAG, attach only.
*
*   /opt/SEGGER/Ozone_V340j/Ozone ozone/hpm5321-dual-can.jdebug
*   ./ozone-debug.sh hpm5321-dual-can
*
* Build first (see ../firmware/rmcs_board/BUILD_ENVIRONMENT.md for the
* toolchain path convention):
*   export GNURISCV_TOOLCHAIN_PATH=~/3rd_party/hpm/rv32imac_zicsr_zifencei_multilib_b_ext-linux
*   cmake --preset debug -S firmware/rmcs_board -DBOARD=hpm5321_dual_can
*   cmake --build firmware/rmcs_board/build --target rmcs_board_bootloader
*
* CM_ATTACH_HALT, NOT CM_DOWNLOAD_RESET like mc02/c_board -- this part's XPI0
* NOR has NO SEGGER flash loader at all (flash-dual-bootloader.sh drives it via
* OpenOCD's hpm_xpi flash driver instead, precisely because JLinkExe/J-Flash/
* Ozone have no algorithm for this NOR). A download step here would just fail,
* so this project only ever attaches.
*
* Program the bootloader first with ./flash-dual-bootloader.sh (one-time, same
* J-Link, JTAG). The bootloader then hands off to the app within milliseconds
* of reset -- same as every other board here -- so a plain attach usually lands
* in app code. To catch the bootloader itself, set a breakpoint on main() and
* reset the board (Ozone's Reset button, or power-cycle) while attached.
*
* DEVICE NAME: ../firmware/rmcs_board/boards/hpm5321_dual_can/hpm5321_dual_can.yaml
* declares soc=HPM5361, device=HPM5361xEGx -- that is the SDK's build target
* (register-compatible superset), same relationship as hpm6e8y building
* against HPM6E80 while the physical die is an HPM6E00 (ozone/hpm6e8y.jdebug).
* The chip actually soldered on this board is marked HPM5321IEG1, so Ozone
* needs the real silicon's name instead: HPM5321xEGx (confirmed present in
* SEGGER's device DB). Do not "fix" this back to HPM5361xEGx from the yaml --
* that name is for the SDK, not the debugger.
*
* To debug the running APPLICATION instead, use:
*   ./ozone-debug.sh hpm5321-dual-can app
* which points this same attach mode at rmcs_board_app_hpm5321_dual_can.elf.
**********************************************************************/

void OnProjectLoad (void) {
  Project.SetDevice ("HPM5321xEGx");
  Project.SetHostIF ("USB", "0");
  Project.SetTargetIF ("JTAG");
  Project.SetTIFSpeed ("4 MHz");

  Debug.SetConnectMode (CM_ATTACH_HALT);

  File.Open ("../firmware/rmcs_board/build/bootloader/output/rmcs_board_bootloader_hpm5321_dual_can.elf");
}
